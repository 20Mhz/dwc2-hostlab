# Out-of-tree build of dwc2 (raspberrypi/linux 359f37f drivers/usb/dwc2/Makefile)
# with the experimental phase hold compiled in. The running kernel's config
# supplies CONFIG_USB_DWC2=m and CONFIG_USB_DWC2_DUAL_ROLE=y.
ccflags-y += -DCONFIG_USB_DWC2_PHASE_HOLD

obj-$(CONFIG_USB_DWC2)	+= dwc2.o
dwc2-y			:= core.o core_intr.o platform.o drd.o params.o
dwc2-y			+= hcd.o hcd_intr.o hcd_queue.o hcd_ddma.o
dwc2-y			+= gadget.o
ifneq ($(CONFIG_DEBUG_FS),)
dwc2-y			+= debugfs.o
endif
