+/**
+ * struct dwc2_phase_hold - experimental control-transfer phase hold
+ * @timer:      releases every hold @timeout_ms after the oldest one began
+ * @timeout_ms: upper bound of a hold, 1..1000 ms
+ * @dev_addr:   USB address whose control transfers are held, 0 = none
+ * @mask:       BIT(DWC2_CONTROL_DATA) and/or BIT(DWC2_CONTROL_STATUS):
+ *              stages that wait for a release before they start
+ * @ready:      host side initialised
+ * @holds:      holds begun
+ * @releases:   holds ended by an explicit release
+ * @timeouts:   holds ended by @timer
+ */
+struct dwc2_phase_hold {
+	struct hrtimer timer;
+	unsigned int timeout_ms;
+	u8 dev_addr;
+	u8 mask;
+	u8 ready;
+	u64 holds;
+	u64 releases;
+	u64 timeouts;
+};
